# Optional explanations. Blank key keeps deterministic template explanations.
EXPLANATION_PROVIDER=template
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Comma-separated local frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Real statistics via the official public OP.GG MCP service. No key required.
STATS_PROVIDER=opgg

# SQLite file; use a persistent volume path in cloud deployment.
# DATABASE_PATH=/data/draftwise.sqlite3
# Set true behind HTTPS in production.
COOKIE_SECURE=false
