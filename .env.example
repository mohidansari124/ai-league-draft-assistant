# Optional explanations. Blank key keeps deterministic template explanations.
EXPLANATION_PROVIDER=template
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Comma-separated local frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Real statistics via the official public OP.GG MCP service. No key required.
STATS_PROVIDER=opgg
